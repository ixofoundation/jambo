# =============================================================================
# JAMBO environment variables
#
# Copy to `.env` and edit. Every variable is NEXT_PUBLIC_*, which means it is
# inlined into the client bundle at build time and is visible to anyone using
# the dApp. Do not put secrets here.
#
# Changing any of these requires restarting `yarn dev` (or rebuilding).
# =============================================================================

# -- Chain selection ----------------------------------------------------------

# REQUIRED. Comma-separated Cosmos chain names as they appear in the Cosmos chain
# registry (https://github.com/cosmos/chain-registry). Chain info is resolved at
# runtime by @ixo/cosmos-chain-resolver, so no RPC endpoints are configured here.
# Suffixes "testnet"/"devnet" are stripped, so list the base name only.
NEXT_PUBLIC_CHAIN_NAMES=impacthub

# Optional. Which of the above chains loads first. Defaults to "impacthub" when
# that name is present in NEXT_PUBLIC_CHAIN_NAMES, otherwise the empty string.
NEXT_PUBLIC_DEFAULT_CHAIN_NAME=impacthub

# Optional. Set truthy to expose testnet and devnet alongside mainnet. Leave unset
# for a mainnet-only dApp.
NEXT_PUBLIC_ENABLE_DEVELOPER_MODE=1

# Optional. Network used on first load: "mainnet" | "testnet" | "devnet".
# Only honoured when NEXT_PUBLIC_ENABLE_DEVELOPER_MODE is truthy; otherwise
# mainnet is forced.
NEXT_PUBLIC_DEFAULT_CHAIN_NETWORK=mainnet

# Local blockchain node port. MUST be 0 for any normal fork.
#
# Any non-zero value replaces the chain-registry lookup entirely with the
# hardcoded ixo chain info in constants/chains.ts (ixo-5 / pandora-8 / devnet-1)
# pointed at http://localhost:<port>. Only set this if you are genuinely running
# a local ixo node.
NEXT_PUBLIC_USE_LOCAL_BLOCKCHAIN_PORT=0

# -- Integrations -------------------------------------------------------------

# Required only if your config.json contains a `kado_buy_crypto` step.
# Without it the Kado on-ramp builds a broken URL and the Buy action fails
# silently. Get a key from https://www.kado.money/
NEXT_PUBLIC_KADO_API_KEY=

# Required only if you enable the WalletConnect option in
# components/Wallets/Wallets.tsx (it is commented out by default).
# Without it getWalletConnect() returns false and WalletConnect is hidden.
# Get a project id from https://cloud.walletconnect.com/
NEXT_PUBLIC_WC_PROJECT_ID=
