# ixo Auth Hub
NEXT_PUBLIC_AUTH_HUB_URL=http://localhost:8787
# "Login with Yoma" (the only button on /auth; IXO team accounts sign in on
# /ixo). NEXT_PUBLIC_AUTH_HUB_SSO_PROVIDER=yoma sends the hub's direct Yoma
# sign-in (sso_provider=yoma, no WorkOS). Unset = the older route through the
# WorkOS organisation below (the hub may alias it to the same direct sign-in).
# Never sent together. NEXT_PUBLIC_AUTH_HUB_SSO_PROMPT=inherit reuses a live
# Yoma session (login = always ask). All inlined at BUILD time: redeploy after a change.
NEXT_PUBLIC_AUTH_HUB_SSO_PROVIDER=
NEXT_PUBLIC_AUTH_HUB_ORGANIZATION_ID=
NEXT_PUBLIC_AUTH_HUB_SSO_PROMPT=
# Set to "true" to bypass auth hub and use mock session data for local development
NEXT_PUBLIC_AUTH_HUB_DEV_BYPASS=false
# Dev bypass only: sign in as a real account of the configured chain and Matrix
# server (its three mnemonics).
NEXT_PUBLIC_DEV_BYPASS_MNEMONIC=""
NEXT_PUBLIC_DEV_BYPASS_MATRIX_MNEMONIC=""
NEXT_PUBLIC_DEV_BYPASS_ED_MNEMONIC=""

# chain network
NEXT_PUBLIC_CHAIN_NETWORK=devnet

# Feegrant
NEXT_PUBLIC_FEEGRANT_URL=""
FEEGRANT_API_KEY=""

# Matrix
NEXT_PUBLIC_MATRIX_HOMESERVER_URL=""
NEXT_PUBLIC_MATRIX_BID_BOT_URL=""
NEXT_PUBLIC_MATRIX_CLAIM_BOT_URL=""
# Room bot that returns the user's encrypted matrix mnemonic in exchange for a
# session-key-signed challenge. Used to repair cross-signing / key backup on app
# load when the in-memory mnemonic is no longer available.
NEXT_PUBLIC_MATRIX_ROOM_BOT_URL=""

# IXO Names worker (names, avatars, Matrix user ids). OPTIONAL — leave blank for
# the network default (constants/names.ts): names.ixo.earth / testnet.names.ixo.earth /
# devnet.names.ixo.earth. Must be https://, or http://localhost / http://127.0.0.1
# for a local worker (e.g. http://localhost:8799); anything else is ignored.
NEXT_PUBLIC_NAMES_WORKER_URL=

# ixo-yoma-jambo-worker base URL (enables subclaim bottom-sheet feature when set)
NEXT_PUBLIC_JAMBO_WORKER_URL=""
# Yoma pull-synchronisation worker (partner API) — hosts the DID<->Yoma link endpoints.
NEXT_PUBLIC_YOMA_SYNC_WORKER_URL=""

# ixo email-notifier worker base URL (enables the Email Notifications section on
# the settings page when set; leave blank to hide the feature). Deployments:
#   devnet  https://dev.email.notifications.ixo.earth
#   testnet https://test.email.notifications.ixo.earth
#   mainnet https://email.notifications.ixo.earth
NEXT_PUBLIC_EMAIL_NOTIFIER_URL=""

# YellowCard worker base URL (deposit/buy + withdraw/sell flows). OPTIONAL —
# leave blank to use the network default (constants/yellowcard.ts):
#   mainnet https://yellowcard.worker.ixo.earth
#   testnet https://test.yellowcard.worker.ixo.earth
NEXT_PUBLIC_YELLOWCARD_WORKER_API=""

# Pause the YellowCard deposit and withdraw flows (e.g. during a YellowCard
# outage): "true" shows a banner and disables both; unset or anything else keeps
# them open. Inlined at build time — change it in Vercel, then redeploy.
NEXT_PUBLIC_YELLOWCARD_RAMPS_PAUSED=""

# Airtime swap: origin of the airtime voucher worker (no path), e.g.
# https://airtime.example.org. Leave blank to hide the feature entirely.
# The worker must list this app's origin in its CORS_ORIGINS. Limits, test mode
# and the service's DID come from the worker itself. See docs/airtime-swap.md.
NEXT_PUBLIC_AIRTIME_VOUCHER_URL=""

# Approve-Payment collection: when the user starts a claim against this collection,
# the form auto-pulls data from one of their own claims in the source collections
# below (and their verified identity: the old kycamllevel1 credential data, or the
# Self credential) to map into the new claim's fields.
# Source collections is a CSV — multiple are supported so a replacement "duplicate"
# collection can be added when an earlier one closes (quota / end date) without
# losing user claims already submitted to the old collection.
NEXT_PUBLIC_APPROVE_PAYMENT_COLLECTION=""
NEXT_PUBLIC_APPROVE_PAYMENT_SOURCE_COLLECTIONS=""

# Old KYC flow (ixo-kyc-server + ComplyCube). It can no longer be started: new
# identity checks go through Self (below). These three stay only so a user who
# is midway through an old check can finish it and save the credential. People
# who already hold the old credential need none of them.
# NEXT_PUBLIC_KYC_ENTITY_ID is the DID of the KYC protocol entity: the protocolId
# passed to the KYC server, and the entity whose support room the app's
# "contact support" buttons open. Blank = the old path is off, and those support
# buttons are hidden.
NEXT_PUBLIC_KYC_ENTITY_ID=""
# KYC_SERVER_URL is read server-side by pages/api/kyc/[...path].ts,
# which proxies browser requests to avoid CORS + untrusted-cert failures.
KYC_SERVER_URL=""

# Dev-only: set to "true" to let the KYC proxy accept self-signed / untrusted TLS
# certs on the upstream KYC server. Never enable in production.
KYC_PROXY_INSECURE=""

# HERE Maps API key (enables the `map-grid-selector` SurveyJS question type).
# Client-side only — restrict it via the domain allowlist on platform.here.com.
# Leave blank to disable the feature gracefully — questions render a stub notice.
NEXT_PUBLIC_HERE_API_KEY=""

# Self identity check (ixo-self): replaces the old KYC flow. See docs/self-kyc-plan.md
# and docs/self-service-account-setup.md.
# NEXT_PUBLIC_SELF_SERVICE_DID is Jambo's service account on this network
# (did:ixo:ixo1...), the audience of the delegation the user signs. Leave blank to
# disable the feature.
# It is read twice: inlined into the browser bundle at BUILD time (the audience the
# user signs for) and read by the server at RUN time (pages/api/self/*). Both must
# be the same account, so set it for the build and for the runtime, and rebuild
# after changing it. A mismatch makes every request fail with a wrong-audience
# error (HTTP 400; the server log says "service_did_mismatch").
NEXT_PUBLIC_SELF_SERVICE_DID=""
# SELF_SERVICE_MNEMONIC is that account's Ed25519 signing mnemonic. SERVER-ONLY
# (read by pages/api/self/*): never prefix it with NEXT_PUBLIC_. Use a different
# one per network, on an account with no funds or other permissions.
SELF_SERVICE_MNEMONIC=""
# Optional, server-only: the entity (did:ixo:entity:<32 hex>) Self shows as "who is
# asking". On chain, the entity must list the service account as a `linkedEntity`
# with `service: "matrix"` and `relationship: "admin"`; without exactly that, Self
# does not show the entity.
SELF_SERVICE_ENTITY_DID=""
