# ixo Auth Hub
NEXT_PUBLIC_AUTH_HUB_URL=http://localhost:8787
# Set to "true" to bypass auth hub and use mock session data for local development
NEXT_PUBLIC_AUTH_HUB_DEV_BYPASS=false

# chain network
NEXT_PUBLIC_CHAIN_NETWORK=devnet

# Feegrant
NEXT_PUBLIC_FEEGRANT_URL=""
FEEGRANT_API_KEY=""

# Matrix
NEXT_PUBLIC_MATRIX_HOMESERVER_URL=""
NEXT_PUBLIC_MATRIX_BID_BOT_URL=""
NEXT_PUBLIC_MATRIX_CLAIM_BOT_URL=""
# Room bot that returns the user's encrypted matrix mnemonic in exchange for a
# session-key-signed challenge. Used to repair cross-signing / key backup on app
# load when the in-memory mnemonic is no longer available.
NEXT_PUBLIC_MATRIX_ROOM_BOT_URL=""

# ixo-yoma-jambo-worker base URL (enables subclaim bottom-sheet feature when set)
NEXT_PUBLIC_JAMBO_WORKER_URL=""

# ixo email-notifier worker base URL (enables the Email Notifications section on
# the settings page when set; leave blank to hide the feature). Deployments:
#   devnet  https://dev.email.notifications.ixo.earth
#   testnet https://test.email.notifications.ixo.earth
#   mainnet https://email.notifications.ixo.earth
NEXT_PUBLIC_EMAIL_NOTIFIER_URL=""

# YellowCard worker base URL (deposit/buy + withdraw/sell flows). OPTIONAL —
# leave blank to use the network default (constants/yellowcard.ts):
#   mainnet https://yellowcard.worker.ixo.earth
#   testnet https://test.yellowcard.worker.ixo.earth
NEXT_PUBLIC_YELLOWCARD_WORKER_API=""

# Approve-Payment collection: when the user starts a claim against this collection,
# the form auto-pulls data from one of their own claims in the source collections
# below (and their kycamllevel1 credential data) to map into the new claim's fields.
# Source collections is a CSV — multiple are supported so a replacement "duplicate"
# collection can be added when an earlier one closes (quota / end date) without
# losing user claims already submitted to the old collection.
NEXT_PUBLIC_APPROVE_PAYMENT_COLLECTION=""
NEXT_PUBLIC_APPROVE_PAYMENT_SOURCE_COLLECTIONS=""

# KYC Credential (leave blank to disable the feature)
# NEXT_PUBLIC_KYC_ENTITY_ID is the DID of the KYC protocol entity — used both to load
# the SurveyJS template (from the entity's linked resources) and as the protocolId
# passed to the KYC server.
NEXT_PUBLIC_KYC_ENTITY_ID=""
# KYC_SERVER_URL is read server-side by pages/api/kyc/[...path].ts,
# which proxies browser requests to avoid CORS + untrusted-cert failures.
KYC_SERVER_URL=""

# Dev-only: set to "true" to let the KYC proxy accept self-signed / untrusted TLS
# certs on the upstream KYC server. Never enable in production.
KYC_PROXY_INSECURE=""

# HERE Maps API key (enables the `map-grid-selector` SurveyJS question type).
# Client-side only — restrict it via the domain allowlist on platform.here.com.
# Leave blank to disable the feature gracefully — questions render a stub notice.
NEXT_PUBLIC_HERE_API_KEY=""
