# ixo Auth Hub
NEXT_PUBLIC_AUTH_HUB_URL=http://localhost:8787
# Set to "true" to bypass auth hub and use mock session data for local development
NEXT_PUBLIC_AUTH_HUB_DEV_BYPASS=false

# chain network
NEXT_PUBLIC_CHAIN_NETWORK=devnet

# Feegrant
NEXT_PUBLIC_FEEGRANT_URL=""
FEEGRANT_API_KEY=""

# Matrix
NEXT_PUBLIC_MATRIX_HOMESERVER_URL=""
NEXT_PUBLIC_MATRIX_BID_BOT_URL=""
NEXT_PUBLIC_MATRIX_CLAIM_BOT_URL=""
# Room bot that returns the user's encrypted matrix mnemonic in exchange for a
# session-key-signed challenge. Used to repair cross-signing / key backup on app
# load when the in-memory mnemonic is no longer available.
NEXT_PUBLIC_MATRIX_ROOM_BOT_URL=""

# ixo-yoma-jambo-worker base URL (enables subclaim bottom-sheet feature when set)
NEXT_PUBLIC_JAMBO_WORKER_URL=""

# Blacklisted claim collection IDs (comma-separated, collections will be hidden)
NEXT_PUBLIC_BLACKLISTED_COLLECTIONS=""

# KYC Credential (leave blank to disable the feature)
# NEXT_PUBLIC_KYC_ENTITY_ID is the DID of the KYC protocol entity — used both to load
# the SurveyJS template (from the entity's linked resources) and as the protocolId
# passed to the KYC server.
NEXT_PUBLIC_KYC_ENTITY_ID=""
# KYC_SERVER_URL is read server-side by pages/api/kyc/[...path].ts,
# which proxies browser requests to avoid CORS + untrusted-cert failures.
KYC_SERVER_URL=""

# Dev-only: set to "true" to let the KYC proxy accept self-signed / untrusted TLS
# certs on the upstream KYC server. Never enable in production.
KYC_PROXY_INSECURE=""

# UNL map credentials (enables the `map-grid-selector` SurveyJS question type)
# Leave blank to disable the feature gracefully — questions render a stub notice.
NEXT_PUBLIC_UNL_MAP_API_KEY=""
NEXT_PUBLIC_UNL_MAP_VPM_ID=""
